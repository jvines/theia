#!/usr/bin/env bash
# Select a running Theia instance before sending XPA commands.
set -euo pipefail

runtime_base=${XDG_RUNTIME_DIR:-/tmp/theia-$(id -u)}
if [[ -n "${XDG_RUNTIME_DIR:-}" ]]; then
    runtime_base="$runtime_base/theia"
fi
usage() {
    echo 'usage: theiactl list | --instance PID get COMMAND... | --instance PID set COMMAND...' >&2
    exit 2
}

# An instance is live only if its pid still exists and belongs to a
# theia-gtk process; a reused pid or a crashed process must not look live.
is_live_instance() {
    local pid=$1
    [[ "$pid" =~ ^[0-9]+$ ]] || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    [[ -r "/proc/$pid/comm" ]] || return 1
    local comm
    comm=$(</proc/"$pid"/comm) || return 1
    [[ "$comm" == theia-gtk ]]
}

# Only remove a directory that is unambiguously one of ours: it matches the
# instance-<pid>-<hex> naming, is a real directory (never a symlink), is
# owned by us, and is private (mode 700). Never follow a symlink here.
is_stale_instance_dir() {
    local directory=$1 name
    name=$(basename "$directory")
    [[ "$name" =~ ^instance-[0-9]+-[0-9A-Fa-f]{8}$ ]] || return 1
    [[ ! -L "$directory" ]] || return 1
    [[ -d "$directory" ]] || return 1
    [[ "$(stat -c '%u' "$directory" 2>/dev/null)" == "$(id -u)" ]] || return 1
    [[ "$(stat -c '%a' "$directory" 2>/dev/null)" == 700 ]] || return 1
    return 0
}

remove_stale_instance_dir() {
    local directory=$1
    is_stale_instance_dir "$directory" || return 1
    rm -rf -- "$directory"
}

if [[ "${1:-}" == list ]]; then
    shopt -s nullglob
    for directory in "$runtime_base"/instance-*; do
        [[ -d "$directory" ]] || continue
        name=$(basename "$directory")
        pid=${name#instance-}
        pid=${pid%%-*}
        if is_live_instance "$pid"; then
            [[ -S "$directory/xpans_unix" || -s "$directory/xpa_method" ]] &&
                printf '%s\t%s\n' "$pid" "$directory"
        else
            remove_stale_instance_dir "$directory" || true
        fi
    done
    exit 0
fi
[[ "${1:-}" == --instance && "${2:-}" =~ ^[0-9]+$ ]] || usage
pid=$2
shift 2
action=${1:-}
[[ "$action" == get || "$action" == set ]] || usage
shift
[[ $# -gt 0 ]] || usage

if ! is_live_instance "$pid"; then
    shopt -s nullglob
    for directory in "$runtime_base"/instance-"$pid"-*; do
        remove_stale_instance_dir "$directory" || true
    done
    echo "theiactl: instance PID $pid is not running" >&2
    exit 1
fi

shopt -s nullglob
matches=("$runtime_base"/instance-"$pid"-*)
[[ ${#matches[@]} -eq 1 ]] || { echo "theiactl: expected one instance for PID $pid" >&2; exit 1; }
instance_dir=${matches[0]}
[[ -d "$instance_dir" && ! -L "$instance_dir" ]] || {
    echo 'theiactl: instance socket unavailable' >&2
    exit 1
}
[[ "$(stat -c '%u' "$instance_dir")" == "$(id -u)" &&
   "$(stat -c '%a' "$instance_dir")" == 700 ]] || {
    echo 'theiactl: instance directory is not private' >&2
    exit 1
}
# A private instance runs its own name server in its directory. A public one
# registers the way DS9 does and records where its DS9:ds9 access point
# listens: naming that address reaches this instance alone, where a plain
# `ds9` would reach every public instance the name server knows.
if [[ -S "$instance_dir/xpans_unix" ]]; then
    export XPA_METHOD=unix
    export XPA_TMPDIR="$instance_dir"
    export XPA_NSUNIX="$instance_dir/xpans_unix"
    target=ds9
elif [[ -f "$instance_dir/xpa_method" && ! -L "$instance_dir/xpa_method" ]]; then
    target=$(<"$instance_dir/xpa_method")
    if [[ "$target" == /* && -S "$target" ]]; then
        # libxpa takes a socket path as a target only inside its XPA_TMPDIR.
        export XPA_METHOD=unix
        XPA_TMPDIR=$(dirname "$target")
        export XPA_TMPDIR
    elif [[ ! "$target" =~ ^[0-9A-Fa-f]+:[0-9]+$ ]]; then
        echo 'theiactl: instance XPA address is unusable' >&2
        exit 1
    fi
else
    echo 'theiactl: instance socket unavailable' >&2
    exit 1
fi
script_dir=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
if [[ "$action" == get ]]; then
    if [[ -x "$script_dir/xpaget" ]]; then helper="$script_dir/xpaget"; else helper=xpaget; fi
    exec "$helper" "$target" "$@"
fi
if [[ -x "$script_dir/xpaset" ]]; then helper="$script_dir/xpaset"; else helper=xpaset; fi
# -p (paramonly) skips reading stdin for a data payload. Only pass it when
# stdin is a terminal: with a pipe or redirect, the caller may be sending a
# data payload (e.g. `theiactl set regions`), and -p would silently discard
# it. When stdin is not a terminal but is empty (e.g. `</dev/null` for a
# parameter-only command run from CI/cron), xpaset reads EOF immediately and
# sends an empty payload, which is harmless for commands that ignore it.
if [[ -t 0 ]]; then
    exec "$helper" -p "$target" "$@"
fi
exec "$helper" "$target" "$@"
