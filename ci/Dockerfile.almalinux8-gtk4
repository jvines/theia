# Build GTK 4.22.5 and its newer dependencies on the same EL8/Swift base used
# for the shared code. GTK's Meson wraps pin source and patch SHA-256 values.
ARG SWIFT_BASE=theia-ci-almalinux8-swift63:latest
FROM mwader/static-ffmpeg:9.0@sha256:b90574a4e2ae62b763c39c384526689e7eb435da6398f4fb3f6c3f1c6a14ce33 AS video_encoder

FROM ${SWIFT_BASE}

RUN dnf install -y dnf-plugins-core \
    && dnf config-manager --set-enabled powertools \
    && dnf install -y \
        gcc-toolset-13 gcc-toolset-13-gcc-c++ \
        ninja-build python3.11 python3.11-pip pkgconf-pkg-config \
        which tar xz file wget patch diffutils \
        zlib-devel libpng-devel libjpeg-turbo-devel libtiff-devel \
        gettext-devel pcre2-devel libffi-devel expat-devel bzip2-devel \
        libX11-devel libXext-devel libXrender-devel libXi-devel \
        libXrandr-devel libXcursor-devel libXdamage-devel libXfixes-devel \
        libXcomposite-devel libXtst-devel libXinerama-devel libxml2-devel \
        mesa-libGL-devel mesa-libEGL-devel \
        fontconfig-devel freetype-devel \
        cairo-devel pixman-devel cups-devel \
        libcurl-devel \
        glib2-devel pango-devel harfbuzz-devel fribidi-devel \
        wayland-devel libxkbcommon-devel \
        shared-mime-info xorg-x11-server-Xvfb xorg-x11-utils \
        mesa-dri-drivers \
    && dnf clean all

# Pin the X11 input driver used only by integration tests without depending on
# EPEL mirror metadata during the much larger GTK dependency transaction.
RUN git clone --branch v3.20150503.1 --depth 1 \
        https://github.com/jordansissel/xdotool.git /tmp/xdotool-src \
    && test "$(git -C /tmp/xdotool-src rev-parse HEAD)" = 3a45f1a2a541896f130ddb82c3afb72987c7344b \
    && make -C /tmp/xdotool-src -j 4 xdotool \
    && install -m 755 /tmp/xdotool-src/xdotool /usr/bin/xdotool \
    && install -m 755 /tmp/xdotool-src/libxdo.so /usr/local/lib64/libxdo.so.3 \
    && rm -rf /tmp/xdotool-src

RUN python3.11 -m pip install --no-cache-dir 'meson==1.12.1' 'ninja==1.13.0'

RUN git clone --branch 4.22.5 --depth 1 https://gitlab.gnome.org/GNOME/gtk.git /tmp/gtk-src \
    && test "$(git -C /tmp/gtk-src rev-parse HEAD)" = bd25f1e2dc2c2fbf3b8864e61afe642910ba359c

ENV PKG_CONFIG_PATH=/usr/local/lib64/pkgconfig:/usr/local/share/pkgconfig
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN source /opt/rh/gcc-toolset-13/enable \
    && export PATH="/root/.local/bin:$PATH" \
    && meson setup /tmp/gtk-build /tmp/gtk-src \
        --buildtype=release \
        --force-fallback-for=glib,pango,harfbuzz,fribidi,cairo,graphene,libepoxy,gdk-pixbuf,wayland,wayland-protocols,libpng,libjpeg-turbo,libtiff,freetype2,pcre2 \
        -Dglib:sysprof=disabled \
        -Dglib:tests=false \
        -Dglib:introspection=disabled \
        -Dglib:documentation=false \
        -Dglib:man-pages=disabled \
        -Dintrospection=disabled \
        -Ddocumentation=false \
        -Dscreenshots=false \
        -Dman-pages=false \
        -Dbuild-tests=false \
        -Dbuild-testsuite=false \
        -Dbuild-examples=false \
        -Dbuild-demos=false \
        -Dmedia-gstreamer=disabled \
        -Dvulkan=disabled \
        -Dprint-cups=enabled \
        -Dprint-cpdb=disabled \
        -Dcloudproviders=disabled \
        -Dsysprof=disabled \
        -Dtracker=disabled \
        -Dcolord=disabled \
        -Daccesskit=disabled \
        -Dx11-backend=true \
        -Dwayland-backend=true \
        -Dbroadway-backend=false \
        -Dwin32-backend=false \
        -Dmacos-backend=false \
        -Dandroid-backend=false \
    && ninja -C /tmp/gtk-build -j 4 \
    && ninja -C /tmp/gtk-build install

RUN echo /usr/local/lib64 > /etc/ld.so.conf.d/theia-gtk.conf \
    && ldconfig \
    && pkg-config --modversion gtk4 | grep -qx 4.22.5 \
    && rm -rf /tmp/gtk-build /tmp/gtk-src

COPY --from=video_encoder /ffmpeg /usr/local/bin/ffmpeg

RUN git clone --branch 0.19.1 --depth 1 https://github.com/NixOS/patchelf.git /tmp/patchelf-src \
    && test "$(git -C /tmp/patchelf-src rev-parse HEAD)" = 7688b17c18d16f67fa8d5a82a2404c2e3a18648d \
    && source /opt/rh/gcc-toolset-13/enable \
    && export PATH="/root/.local/bin:$PATH" \
    && meson setup /tmp/patchelf-build /tmp/patchelf-src --buildtype=release \
    && ninja -C /tmp/patchelf-build -j 4 install \
    && rm -rf /tmp/patchelf-src /tmp/patchelf-build

# The package bundles a monospace face so FITS headers stay aligned on hosts
# without fonts. Installed late to keep the cached GTK layers above.
RUN dnf install -y dejavu-sans-mono-fonts && dnf clean all

# The package reads the host's fontconfig rules, and newer distros write them
# with syntax the 2.15 that GTK's build pulled in rejects, warning on every
# launch. Replace it with a fontconfig as new as the newest target's rules.
RUN git clone --branch 2.18.3 --depth 1 \
        https://gitlab.freedesktop.org/fontconfig/fontconfig.git /tmp/fontconfig-src \
    && test "$(git -C /tmp/fontconfig-src rev-parse HEAD)" = 0f236723a3c26bd9745e32ba2b3ee21e5f809295 \
    && source /opt/rh/gcc-toolset-13/enable \
    && export PATH="/root/.local/bin:$PATH" \
    && meson setup /tmp/fontconfig-build /tmp/fontconfig-src \
        --prefix=/usr/local --libdir=lib64 --buildtype=release \
        -Ddoc=disabled -Dnls=disabled -Dtests=disabled -Dtools=enabled \
        -Dcache-build=disabled -Dxml-backend=expat \
    && ninja -C /tmp/fontconfig-build -j 4 install \
    && ldconfig \
    && pkg-config --modversion fontconfig | grep -qx 2.18.3 \
    && rm -rf /tmp/fontconfig-src /tmp/fontconfig-build

# Arch's fontconfig 2.18.3 rules, linked as pacman links them, so the package
# check can prove the bundled fontconfig reads current distro rules silently.
RUN dnf install -y zstd && dnf clean all \
    && curl -fLSs --retry 3 -o /tmp/fontconfig.pkg.tar.zst \
        'https://archive.archlinux.org/packages/f/fontconfig/fontconfig-2%3A2.18.3-2-x86_64.pkg.tar.zst' \
    && echo 'c3d961568e10d0bc035b52554333535d31853310b9b7936eedf5d026425d3adf  /tmp/fontconfig.pkg.tar.zst' \
        | sha256sum --check --status \
    && mkdir -p /tmp/arch-fontconfig /opt/fontconfig-rules/arch-2.18.3/conf.d \
    && zstd -dc /tmp/fontconfig.pkg.tar.zst | tar -x -C /tmp/arch-fontconfig etc/fonts usr/share/fontconfig \
    && cp /tmp/arch-fontconfig/etc/fonts/fonts.conf /opt/fontconfig-rules/arch-2.18.3/ \
    && cp -L /tmp/arch-fontconfig/usr/share/fontconfig/conf.default/*.conf \
        /opt/fontconfig-rules/arch-2.18.3/conf.d/ \
    && rm -rf /tmp/arch-fontconfig /tmp/fontconfig.pkg.tar.zst

ENV LD_LIBRARY_PATH=/usr/local/lib64:/opt/rh/gcc-toolset-13/root/usr/lib64
ENV FONTCONFIG_FILE=/etc/fonts/fonts.conf
ENV GSK_RENDERER=cairo
ENV LC_ALL=C.utf8
WORKDIR /src
